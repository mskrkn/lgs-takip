# Öğrenci kişisel verisi içeren dosyalar - herkese açık yayına dahil edilmemeli
deneme_sonuclari.csv
*.csv

# Yardımcı/tek seferlik Python betikleri (örnek/gerçek öğrenci verisi gömülü
# olabilir). server.py, pdf_question_extractor.py ve soru_havuzu_drive.py
# bunun DIŞINDA - üçü de uygulamanın gerçek backend'inin parçası, sürüm
# kontrolünde olmalı.
*.py
!server.py
!pdf_question_extractor.py
!diagnose_pdf_extraction.py
!soru_havuzu_drive.py
!soru_havuzu_merge.py
__pycache__/

# Soru Havuzu: yüklenen kaynak PDF'ler ve kırpılan soru görüntüleri -
# çalışma zamanında üretilir, öğrenci/telif içerikli olabilir, sürüm
# kontrolüne dahil edilmemeli (yetki_veritabani.db ile aynı mantık).
uploads/

# Yerel/geçici
agentler
.DS_Store
Thumbs.db

# Windows servis kurulumu logları (servis_kur.bat / servis_duzelt.bat tarafından oluşturulur)
servis_log.txt
servis_hata.txt
tunnel_log.txt
tunnel_hata.txt

# Yetkilendirme veritabanı ve gizli anahtar - kullanıcı şifre hash'leri
# içerir, asla paylaşılmamalı/yayınlanmamalı
yetki_veritabani.db
.flask_secret_key
firebase-adminsdk-key.json

# Drive Soru Havuzu entegrasyonu (2. Adım) - EduPusula Soru Merkezi'nin
# yazdığı ortak Sheets/Drive havuzunu OKUMAK için kullanılan servis hesabı
# anahtarı - repo'ya commit edilmez (firebase-adminsdk-key.json ile aynı mantık).
soru-havuzu-service-account.json

# gunicorn worker'ları arasında init_db()'yi tek sıraya sokan dosya kilidi -
# içeriği yok, sadece fcntl.flock için bir tutamaç (bkz. server.py init_db() çağrısı üstündeki not)
.init_db.lock

# Üçüncü taraf optik okuyucu tarayıcı yazılımı ayar dosyaları (referans
# amaçlı tutuluyor, uygulamanın çalışması için gerekli değil, dağıtılmaması
# daha uygun - bkz. js/optikProfiles.js üstündeki not)
form Okutma Ayarları ve örnet formatlar/
# Aynı klasörün OneDrive senkronizasyonundan kalma, dosya adında Türkçe
# karakterlerin bozulduğu ikinci bir kopyası (ı/ö yerine literal "#U0131"/
# "#U00f6" metni) - muhtemelen silinebilir, ama emin olana kadar sadece
# görmezden geliniyor.
form Okutma Ayarlar#U0131 ve #U00f6rnet formatlar/

# Eski sunucu koduna ait yedek dosyalar
*.bak
